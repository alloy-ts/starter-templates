{
  "name": "@lib/crypto",
  "version": "0.1.0",
  "files": [
    "dist",
    "index.js",
    "index.cjs",
    "index.d.ts",
    "*.node"
  ],
  "type": "module",
  "types": "index.d.ts",
  "exports": {
    ".": "./dist/main.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.js --platform",
    "build:release": "node build.js --platform --release",
    "dev": "vp pack --watch",
    "start": "vp run src/main.ts",
    "test": "vp test src/*.test.ts",
    "check": "vp check",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "prepublishOnly": "vp run build",
    "prepare": "vp config",
    "ci": "node scripts/ci.ts",
    "ci:check": "vp check package.json vite.config.ts src/ scripts/ build.js build.mjs",
    "ci:build": "node build.js --platform",
    "ci:test": "vp test src/*.test.ts",
    "ci:cross-build": "node scripts/ci.ts --job cross-build",
    "ci:publish": "vp pack"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3",
    "@types/node": "^26.6.2",
    "@voidzero-dev/vite-task-client": "^0.2.0",
    "vite-plus": "^1.0.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "napi": {
    "binaryName": "crypto",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "i686-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "armv7-unknown-linux-gnueabihf",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "aarch64-linux-android",
      "armv7-linux-androideabi",
      "x86_64-unknown-freebsd",
      "wasm32-wasip1-threads"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.11.0",
      "onFail": "download"
    }
  }
}
