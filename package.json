{
  "name": "@lib/module",
  "version": "0.0.0",
  "files": [
    "dist",
    "index.js",
    "index.d.ts"
  ],
  "type": "module",
  "types": "index.d.ts",
  "exports": {
    ".": "./dist/main.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && node build.js",
    "build:napi": "node build.js",
    "build:release": "node build.js --release",
    "dev": "vp pack --watch",
    "start": "vp run src/main.ts",
    "test": "vp test && node --test test.cjs",
    "check": "vp check",
    "ci": "vp run ci",
    "ci:local": "tsx scripts/ci.ts --job all",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.5",
    "@emnapi/runtime": "2.0.0-alpha.5",
    "@napi-rs/cli": "^3.10.5",
    "@types/node": "^26.6.2",
    "@voidzero-dev/vite-task-client": "^0.2.0",
    "emnapi": "2.0.0-alpha.5",
    "tsx": "^4.23.15",
    "vite-plus": "^1.0.0-rc.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@emnapi/core": "2.0.0-alpha.5",
    "@emnapi/runtime": "2.0.0-alpha.5",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0-rc.1"
  },
  "napi": {
    "binaryName": "my-addon",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "i686-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "armv7-unknown-linux-gnueabihf",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "aarch64-linux-android",
      "armv7-linux-androideabi",
      "x86_64-unknown-freebsd",
      "wasm32-wasip1-threads"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.11.0",
      "onFail": "download"
    }
  }
}
